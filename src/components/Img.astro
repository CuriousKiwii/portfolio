---
/**
 * Blur-up lazy image. The Plaiceholder blur shows instantly, vanilla-lazyload swaps in
 * the Guetzli-compressed thumbnail when it scrolls into view.
 */
import images from "../data/images.json";
import { u } from "../lib/url";

interface Props {
  id: string; // e.g. "narcisse/narcisse-1-cover"
  alt: string;
  class?: string;
  full?: boolean; // use the 1600px image instead of the thumbnail
  eager?: boolean;
}
const { id, alt, class: cls = "", full = false, eager = false } = Astro.props;
const img = (images as Record<string, { src: string; thumb: string; width: number; height: number; blur: string }>)[id];
if (!img) throw new Error(`Unknown image ${id}. Run npm run images.`);
const src = u(full ? img.src : img.thumb);
---

{eager ? (
  <img src={src} alt={alt} width={img.width} height={img.height} class={cls} decoding="async" fetchpriority="high" />
) : (
  <img
    src={img.blur}
    data-src={src}
    alt={alt}
    width={img.width}
    height={img.height}
    class:list={["lazy", cls]}
    decoding="async"
  />
)}
