---
import { profile } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-base-content/10 bg-base-200">
  <div class="section flex flex-col items-center justify-between gap-4 py-8 text-sm text-base-content/70 sm:flex-row">
    <p>
      © {year} {profile.name} · {profile.business}. Web & IT for small businesses, churches, and nonprofits.
    </p>
    <div class="flex items-center gap-4 text-lg">
      <a href={profile.github} target="_blank" rel="noopener" aria-label="GitHub" class="hvr-float hover:text-primary">
        <i class="fa-brands fa-github"></i>
      </a>
      <a href={profile.fiverr} target="_blank" rel="noopener" aria-label="Fiverr" class="hvr-float hover:text-primary">
        <span class="icon-[simple-icons--fiverr]"></span>
      </a>
      <a href="#top" aria-label="Back to top" class="hvr-float hover:text-primary">
        <i data-feather="arrow-up" class="size-5"></i>
      </a>
    </div>
  </div>
</footer>
